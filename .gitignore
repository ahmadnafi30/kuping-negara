# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and test artifacts
build/
dist/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Local data and model artifacts
tweets-data/
# The raw zone has its own ignore rules so DVC can discover metadata.
data/quarantine/
data/processed/*
!data/processed/.gitkeep
data/labeled/*
!data/labeled/.gitkeep
models/*
!models/.gitkeep
mlruns/
.dvc/cache/

# Airflow and application runtime artifacts
airflow.cfg
airflow.db
logs/
*.log
docker/airflow/secrets/
docker/collector/node_modules/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated assignment artifacts and local audit work
output/
tmp/

# Project-local dependency download cache
.cache/
