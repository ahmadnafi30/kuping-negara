{
  "name": "Kuping Negara — LK-10 serving",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r deploy/lk10/requirements-tools.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [
    5000,
    8001,
    8002
  ],
  "portsAttributes": {
    "5000": {
      "label": "MLflow registry"
    },
    "8001": {
      "label": "Native MLflow serving"
    },
    "8002": {
      "label": "MLflow replica gateway"
    }
  },
  "remoteUser": "vscode"
}
